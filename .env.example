NODE_ENV=development
HOST_UID=1000
HOST_GID=1000
NEXT_PUBLIC_API_URL=http://localhost:3333
DATABASE_URL=postgresql://cvforge:secret@postgres:5432/cvforge
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=cvforge
MINIO_SECRET_KEY=secretminio
PUPPETEER_URL=http://puppeteer:3000
OPENROUTER_API_KEY=
# Avoid mistral-small-2603: Mistral is its only provider, so a throttle on
# OpenRouter's shared pool leaves no way through. This variant is the same
# family served by DeepInfra, Parasail and Venice, and costs less.
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Tried in order when every provider of OPENROUTER_MODEL is exhausted (typically
# an upstream 429 on the shared Mistral pool). A candidate needs SEVERAL
# providers and structured-output support, or it repeats the single-provider
# trap this chain exists to escape.
# Defaults to openai/gpt-4.1-nano,google/gemini-2.5-flash. "none" disables.
# NOTE: the providers serving these models must be allowed on the OpenRouter
# account (https://openrouter.ai/settings/privacy), otherwise every fallback 404s.
# OPENROUTER_FALLBACK_MODELS=
# Attempts per request, first call included. Retries only transient failures
# (429/5xx/network) with exponential backoff. Default 3; 1 disables retrying.
# OPENROUTER_MAX_ATTEMPTS=3
# Defaults to https://openrouter.ai/api/v1; override only for a proxy.
# OPENROUTER_BASE_URL=
# Balance supervision (admin). Must be a MANAGEMENT key, not the inference key
# above: GET /credits answers 403 to anything else
# (create one at https://openrouter.ai/settings/management-keys). Left empty, supervision is
# simply disabled. The threshold is in OpenRouter credits (USD), default 5.
OPENROUTER_MANAGEMENT_API_KEY=
OPENROUTER_BALANCE_ALERT_THRESHOLD=5
# Balance at or below which selling credits is refused (503). Default 0: a sale
# is blocked only once the account is truly empty, never on a merely low balance.
OPENROUTER_BALANCE_CRITICAL_THRESHOLD=0
# /admin/metrics: fixed USD->EUR rate for the net-margin estimate (revenue is
# billed in EUR, OpenRouter in USD), and the usage window that makes an account
# "active". Defaults 0.92 and 30.
METRICS_USD_TO_EUR_RATE=0.92
METRICS_ACTIVE_WINDOW_DAYS=30
# Interview speech-to-text, through OpenRouter's /audio/transcriptions endpoint
# (ADR-013). The chain is walked by the API itself — that endpoint applies no
# routing controls of its own. Blank means the defaults below; "none" on the
# fallback list pins the primary and disables failover.
# Defaults: openai/whisper-large-v3-turbo, then mistralai/voxtral-mini-3b-2507,
# then nvidia/nemotron-3.5-asr-streaming-multilingual-0.6b.
# Beware: the account's privacy settings decide what resolves at all — as of
# 2026-09-21 voxtral-mini-transcribe and qwen3-asr-flash return 404 "ZDR
# violation (account settings)". Re-probe before changing these.
INTERVIEW_STT_MODEL=openai/whisper-large-v3-turbo
# INTERVIEW_STT_FALLBACK_MODELS=
# Interview voice: one speech-to-speech call per turn (audio in, audio out),
# which is what the candidate actually hears. Measured on a French turn,
# 2026-09-21: gpt-audio-mini answers in 1129 ms for $0.00044, gpt-audio in
# 751 ms for $0.00822 — nineteen times the price for 378 ms. The mini leads
# the chain; set INTERVIEW_VOICE_MODEL to swap them. Both need the `openai`
# provider allowed on the account.
# INTERVIEW_VOICE_MODEL=openai/gpt-audio-mini
# INTERVIEW_VOICE_FALLBACK_MODELS=openai/gpt-audio
# One of the provider's preset voices. Default alloy.
# INTERVIEW_VOICE=alloy
# Deliberately separate from OPENROUTER_MAX_ATTEMPTS: a spoken turn has a
# budget of about a second, so it fails over to the next model rather than
# retrying a slow one. Default 2.
# INTERVIEW_VOICE_MAX_ATTEMPTS=2
# Caps the reply — an interviewer asks a question, it does not lecture.
# INTERVIEW_VOICE_MAX_TOKENS=400
# Per-request ZDR (data_collection: "deny") — restricts OpenRouter routing to
# providers that advertise ZDR support. Check https://openrouter.ai/api/v1/endpoints/zdr
# ENABLE_ZDR_CHAT: set true for chat/LLM model if it supports ZDR (e.g. mistral-small does)
# ENABLE_ZDR_STT: unused since ADR-013 — the transcription endpoint takes no
# provider filter, and the account-level ZDR rule applies regardless.
ENABLE_ZDR_CHAT=false
ENABLE_ZDR_STT=false
# Restricted key (rk_...) of a Stripe sandbox locally and on staging, live key in
# production. Webhook secret: `stripe listen --forward-to localhost:3333/billing/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Balance below which a user sees the low-credit warning. Default 20.
CREDITS_LOW_BALANCE_THRESHOLD=20
SMTP_PROVIDER=resend
SMTP_SERVER=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=CVforge <no-reply@example.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_MAGIC_LINK_TTL_MINUTES=15
# Recommended default for US-009. Final product decision still pending.
AUTH_SESSION_TTL_DAYS=7
AUTH_COOKIE_NAME=cvforge_session
AUTH_SESSION_SECRET=change-me-for-production
# Optional override for the one-time first-admin bootstrap state file.
AUTH_STATE_FILE=
# Optional override for persisted draft candidatures created from offer URLs.
APPLICATIONS_STATE_FILE=

# Production routing via docker-compose.prod.yml
APP_DOMAIN=app.cvforge.local
# CVForge v2 (apps/web). To make it the main app, point the API NEXT_PUBLIC_APP_URL at it.
WEB_DOMAIN=web.cvforge.local
LANDING_DOMAIN=cvforge.local
API_DOMAIN=api.cvforge.local
LETSENCRYPT_EMAIL=ops@example.com
TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_DASHBOARD_HOST=traefik.cvforge.local
TRAEFIK_LOG_LEVEL=INFO
