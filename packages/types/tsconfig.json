{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    // Without this, tsc infers the module format from target ES2022 and emits
    // ESM. The package has no "type": "module", so Node parses dist/index.js as
    // CommonJS, detects the ESM syntax, re-parses it as ESM, and then rejects
    // the extensionless relative imports tsc wrote. Node16 emits CommonJS, for
    // which extensionless is valid — and it matches document-renderer.
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
